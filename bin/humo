#!/usr/bin/env bash

# Make script executable from any directory
cd "$(dirname "$0")/.."

# Default values
CONTAINER="php"
SERVICE="php"
DB_CONTAINER="mysql"
DUMPS_DIR="database/dumps"

# Help text
show_help() {
    echo "HuMo-genealogy CLI Tool"
    echo
    echo "Usage: humo COMMAND [OPTIONS]"
    echo
    echo "Database Migration Commands:"
    echo "  migrate              Run database migrations"
    echo "  migrate:rollback     Rollback the last database migration"
    echo "  migrate:fresh        Drop all tables and re-run migrations"
    echo "  db:seed             Run database seeders"
    echo
    echo "Database State Commands:"
    echo "  db:export [name]     Export database to a dump file (default: branch name)"
    echo "  db:import [name]     Import database from a dump file (default: branch name)"
    echo "  db:list             List available database dumps"
    echo "  db:switch           Export current branch DB and import target branch DB"
    echo
    echo "Generator Commands:"
    echo "  make:migration      Create a new migration file"
    echo "  make:seeder         Create a new seeder file"
    echo "  make:factory        Create a new factory file"
    echo
    echo "Options:"
    echo "  --help              Show this help message"
}

# Check if Docker is running
check_docker() {
    if ! docker info > /dev/null 2>&1; then
        echo "Error: Docker is not running"
        exit 1
    }
}

# Check if containers are running
check_containers() {
    if ! docker compose ps | grep -q "php.*running"; then
        echo "Error: Docker containers are not running"
        echo "Please start the containers with: docker compose up -d"
        exit 1
    }
}

# Get current git branch name
get_branch_name() {
    git branch --show-current
}

# Execute command in PHP container
docker_exec() {
    docker compose exec -T "$SERVICE" php "$@"
}

# Create timestamp for migration name
timestamp() {
    date "+%Y_%m_%d_%H%M%S"
}

# Ensure dumps directory exists
ensure_dumps_dir() {
    mkdir -p "$DUMPS_DIR"
}

# Export database
export_db() {
    local name=${1:-$(get_branch_name)}
    ensure_dumps_dir
    echo "Exporting database to $DUMPS_DIR/$name.sql..."
    docker compose exec -T $DB_CONTAINER mysqldump -u"${MYSQL_USER}" -p"${MYSQL_PASSWORD}" "${MYSQL_DATABASE}" > "$DUMPS_DIR/$name.sql"
    echo "Database exported successfully!"
}

# Import database
import_db() {
    local name=${1:-$(get_branch_name)}
    local dump_file="$DUMPS_DIR/$name.sql"
    
    if [ ! -f "$dump_file" ]; then
        echo "Error: Dump file $dump_file not found"
        exit 1
    }
    
    echo "Importing database from $dump_file..."
    docker compose exec -T $DB_CONTAINER mysql -u"${MYSQL_USER}" -p"${MYSQL_PASSWORD}" "${MYSQL_DATABASE}" < "$dump_file"
    echo "Database imported successfully!"
}

# List available dumps
list_dumps() {
    ensure_dumps_dir
    echo "Available database dumps:"
    ls -l "$DUMPS_DIR"
}

# Switch database between branches
switch_db() {
    local current_branch=$(get_branch_name)
    echo "Current branch: $current_branch"
    
    # Export current database state
    export_db "$current_branch"
    
    # Prompt for target branch
    read -p "Enter target branch name to import: " target_branch
    
    if [ ! -f "$DUMPS_DIR/$target_branch.sql" ]; then
        echo "Error: No database dump found for branch $target_branch"
        exit 1
    }
    
    # Import target database
    import_db "$target_branch"
}

# Load environment variables
if [ -f .env ]; then
    export $(cat .env | grep -v '^#' | xargs)
fi

# Main script logic
main() {
    check_docker
    check_containers

    case "$1" in
        migrate)
            docker_exec humo migrate "${@:2}"
            ;;
        migrate:rollback)
            docker_exec humo migrate rollback
            ;;
        migrate:fresh)
            echo "Warning: This will drop all tables and re-run migrations"
            read -p "Are you sure you want to continue? [y/N] " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                docker_exec humo migrate fresh
            fi
            ;;
        db:seed)
            docker_exec humo db:seed "${@:2}"
            ;;
        db:export)
            export_db "${2}"
            ;;
        db:import)
            import_db "${2}"
            ;;
        db:list)
            list_dumps
            ;;
        db:switch)
            switch_db
            ;;
        make:migration)
            if [ -z "$2" ]; then
                echo "Error: Migration name is required"
                echo "Usage: humo make:migration <name>"
                exit 1
            fi
            name=$(timestamp)_"$2"
            cp database/migrations/migration.stub database/migrations/"$name".php
            sed -i "s/DummyClass/$2/g" database/migrations/"$name".php
            echo "Created migration: database/migrations/$name.php"
            ;;
        make:seeder)
            if [ -z "$2" ]; then
                echo "Error: Seeder name is required"
                echo "Usage: humo make:seeder <name>"
                exit 1
            fi
            cp database/seeders/seeder.stub database/seeders/"$2".php
            sed -i "s/DummyClass/$2/g" database/seeders/"$2".php
            echo "Created seeder: database/seeders/$2.php"
            ;;
        make:factory)
            if [ -z "$2" ]; then
                echo "Error: Factory name is required"
                echo "Usage: humo make:factory <name>"
                exit 1
            fi
            cp database/factories/factory.stub database/factories/"$2"Factory.php
            sed -i "s/DummyClass/$2/g" database/factories/"$2"Factory.php
            echo "Created factory: database/factories/${2}Factory.php"
            ;;
        --help|-h)
            show_help
            ;;
        *)
            echo "Error: Unknown command '$1'"
            echo "Run 'humo --help' for usage information"
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@" 