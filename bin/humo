#!/usr/bin/env bash

# Make script executable from any directory
cd "$(dirname "$0")/.."

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
    echo "Error: Docker is not running"
    exit 1
fi

# Check if containers are running
if ! docker compose ps | grep -q "humo-genealogy-dev-php-1.*healthy"; then
    echo "Error: PHP container is not running or not healthy"
    echo "Please start the containers with: docker compose up -d"
    exit 1
fi

# Run the command in the PHP container from the project root
docker compose exec -T -w /var/www/html php php bin/humo.php "$@" 