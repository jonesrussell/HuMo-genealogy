#!/usr/bin/env bash

# Make script executable from any directory
cd "$(dirname "$0")/.."

# Check if Docker is running
if ! docker info > /dev/null 2>&1; then
    echo "Error: Docker is not running"
    exit 1
fi

# Check if containers are running
if ! docker compose ps | grep -q "php.*running"; then
    echo "Error: Docker containers are not running"
    echo "Please start the containers with: docker compose up -d"
    exit 1
fi

# Run the command in the PHP container
docker compose exec -T php php /var/www/html/bin/humo.php "$@" 