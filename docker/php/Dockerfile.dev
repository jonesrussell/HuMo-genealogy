FROM php:8.3-fpm-alpine AS builder

# Install build dependencies
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    linux-headers \
    git \
    curl \
    libpng-dev \
    oniguruma-dev \
    libxml2-dev

# Install production dependencies
RUN apk add --no-cache \
    libpng \
    libonig \
    libxml2

# Install PHP extensions
RUN docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    opcache

# Install composer
COPY --from=composer:2.6 /usr/bin/composer /usr/bin/composer

# Configure OPcache
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=1'; \
} > /usr/local/etc/php/conf.d/opcache-recommended.ini

FROM php:8.3-fpm-alpine

# Copy PHP extensions and configs from builder
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/
COPY --from=builder /usr/bin/composer /usr/bin/composer

# Install runtime dependencies
RUN apk add --no-cache \
    libpng \
    libonig \
    libxml2

# Set working directory
WORKDIR /var/www/html

# Create directories and set permissions
RUN mkdir -p /var/www/html/storage /var/www/html/media \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/media

# Create user with same ID as host
ARG USERID=1000
ARG GROUPID=1000

# Add non-root user
RUN addgroup -g ${GROUPID} appgroup && \
    adduser -u ${USERID} -G appgroup -h /home/appuser -s /bin/sh -D appuser

# Configure PHP-FPM to run as non-root user
RUN sed -i "s/user = www-data/user = appuser/g" /usr/local/etc/php-fpm.d/www.conf && \
    sed -i "s/group = www-data/group = appgroup/g" /usr/local/etc/php-fpm.d/www.conf && \
    sed -i "s/listen.owner = www-data/listen.owner = appuser/g" /usr/local/etc/php-fpm.d/www.conf && \
    sed -i "s/listen.group = www-data/listen.group = appgroup/g" /usr/local/etc/php-fpm.d/www.conf

# Copy PHP config
COPY docker/php/custom.ini /usr/local/etc/php/conf.d/custom.ini

# Set ownership
RUN chown -R appuser:appgroup /var/www/html

# Add security headers
ENV PHP_SECURITY_HEADERS="1"

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD php-fpm -t || exit 1
