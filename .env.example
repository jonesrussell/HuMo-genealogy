# Database Configuration
MYSQL_HOST=mariadb
MYSQL_DATABASE=humo-gen
MYSQL_USER=humo_user
MYSQL_PASSWORD=your_secure_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Application Ports
APP_PORT=8086          # Main application port
DB_PORT=33366         # MariaDB port (localhost only)
DB_ADMIN_PORT=8087    # Adminer port (localhost only)

# User/Group IDs for container permissions
# Use `id -u` and `id -g` to get your values
USERID=1000
GROUPID=1000
