# Application Settings
APP_NAME=HuMo-genealogy
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8086
APP_PORT=8086          # Main application port

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=33366         # MariaDB port (localhost only)
DB_DATABASE=humo-gen
DB_USERNAME=humo_user
DB_PASSWORD=your_secure_password
DB_ADMIN_PORT=8087    # Adminer port (localhost only)

# Legacy compatibility (used by old code)
MYSQL_HOST=${DB_HOST}
MYSQL_PORT=${DB_PORT}
MYSQL_DATABASE=${DB_DATABASE}
MYSQL_USER=${DB_USERNAME}
MYSQL_PASSWORD=${DB_PASSWORD}
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Container User/Group IDs (for proper file permissions)
USERID=1000
GROUPID=1000

# Mail Configuration (for future use)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
